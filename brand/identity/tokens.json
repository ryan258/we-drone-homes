{
  "name": "We Drone Homes",
  "version": "1.0",
  "color": {
    "paper": "#F5F3EB",
    "white": "#FFFEF8",
    "ink": "#192D27",
    "muted": "#59655A",
    "line": "#D3D7C9",
    "yellow": "#E8EE79",
    "tint": "#E9ECDF",
    "focus": "#986400",
    "hoverDark": "#345044",
    "hoverYellow": "#F5FFA0"
  },
  "role": {
    "surface": "paper",
    "surfaceCard": "white",
    "surfaceAlternate": "tint",
    "surfaceInverse": "ink",
    "text": "ink",
    "textSecondary": "muted",
    "textInverse": "paper",
    "borderDecorative": "line",
    "borderFunctional": "muted",
    "accent": "yellow",
    "onAccent": "ink",
    "focusOnLight": "focus",
    "focusOnDark": "yellow",
    "buttonPrimary": "ink",
    "buttonPrimaryText": "white",
    "buttonPrimaryHover": "hoverDark",
    "buttonInverse": "yellow",
    "buttonInverseText": "ink",
    "buttonInverseHover": "hoverYellow"
  },
  "font": {
    "sans": ["Arial", "Helvetica", "sans-serif"],
    "mono": ["Courier New", "monospace"],
    "body": { "size": "1rem", "lineHeight": 1.6 },
    "display": { "weight": 700, "lineHeight": 1.05, "tracking": "-.045em" },
    "telemetry": { "minSize": "0.75rem", "weight": 700, "lineHeight": 1.6, "tracking": ".085em" }
  },
  "space": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "icon": {
    "viewBox": "0 0 24 24",
    "strokeWidth": 1.65,
    "minSize": "16px",
    "defaultSize": "24px",
    "preferredControlHitSize": "44px"
  },
  "contrast": [
    { "foreground": "ink", "background": "paper", "ratio": 13.07, "use": "body and headings" },
    { "foreground": "ink", "background": "white", "ratio": 14.37, "use": "cards" },
    { "foreground": "ink", "background": "tint", "ratio": 12.12, "use": "alternate surfaces" },
    { "foreground": "ink", "background": "yellow", "ratio": 11.71, "use": "accent panels" },
    { "foreground": "muted", "background": "paper", "ratio": 5.50, "use": "secondary text and field outlines" },
    { "foreground": "muted", "background": "white", "ratio": 6.05, "use": "secondary text and field outlines" },
    { "foreground": "muted", "background": "tint", "ratio": 5.10, "use": "secondary text and field outlines" },
    { "foreground": "paper", "background": "ink", "ratio": 13.07, "use": "reverse text" },
    { "foreground": "yellow", "background": "ink", "ratio": 11.71, "use": "inverse accent and focus" },
    { "foreground": "white", "background": "hoverDark", "ratio": 8.74, "use": "primary button hover" },
    { "foreground": "ink", "background": "hoverYellow", "ratio": 13.62, "use": "inverse button hover" },
    { "foreground": "focus", "background": "paper", "ratio": 4.55, "use": "focus indicator" },
    { "foreground": "focus", "background": "white", "ratio": 5.00, "use": "focus indicator" },
    { "foreground": "focus", "background": "tint", "ratio": 4.22, "use": "focus indicator" },
    { "foreground": "focus", "background": "yellow", "ratio": 4.07, "use": "focus indicator" }
  ]
}
